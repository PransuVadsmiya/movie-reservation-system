# Copy this file to .env before running docker-compose up

# Postgres
DATABASE_URL=postgresql+psycopg2://movie_user:movie_pass@postgres:5432/movie_reservation

# Redis (used for seat locks, caching, and as the Celery broker/backend)
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change_this_to_a_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Seat lock TTL (seconds) - how long a user has to confirm after selecting seats
SEAT_LOCK_TTL_SECONDS=300

# Admin report cache TTL (seconds) - how stale revenue/occupancy numbers can be
REPORT_CACHE_TTL_SECONDS=60

# Seed admin (created on startup if it doesn't exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password
